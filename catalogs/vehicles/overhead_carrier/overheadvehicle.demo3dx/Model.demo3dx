              <ReadOnly>1</ReadOnly>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Sim3D</Category>
              <Type>xsd:string</Type>
              <Value xsi:type="xsd:string">Idle</Value>
            </e>
          </CP>
