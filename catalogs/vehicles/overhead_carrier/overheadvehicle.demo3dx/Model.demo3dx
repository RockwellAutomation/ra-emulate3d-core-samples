            <e xsi:type="e3d:CustomProperty">
              <Name>JobAssignedWaitingForVehicleProcedure</Name>
              <Description>Overrides default job assignment logic. Jobs are not added to the default JobList and instead must be manually assigned to Vehicles. This can be done using the "assign job {job} to vehicle { vehicle }" widget.</Description>
              <CS>
                <Id>2fcbe604-34d5-4dbf-aa77-cf15e7b4061a</Id>
              </CS>
              <Category>Procedures</Category>
