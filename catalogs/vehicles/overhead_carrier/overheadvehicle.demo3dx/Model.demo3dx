    <V Name="V1" Parent="ddbc097b-127d-43af-8029-a22e0244ae13" xsi:type="e3d:BoxVisual">
      <LR>1.9458672|||||</LR>
      <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
      <P xsi:type="e3d:BoxProperties">
        <AttachDirection xsi:type="Demo3D.Visuals.AttachDirection">Nearest</AttachDirection>
        <AttachToConveyor>1</AttachToConveyor>
        <CastsShadow>0</CastsShadow>
        <CustomProperties>
          <CP>
            <e xsi:type="e3d:CustomProperty">
              <Name>_QuickBuild</Name>
              <Hidden>1</Hidden>
              <Category>QuickBuilder</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>AccumulationDistance</Name>
              <Description>The minimum spacing to maintain between this vehicle and the next, not including front and rear offsets of the vehicles.</Description>
              <Hidden>1</Hidden>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">0.1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>AccumulationReleaseDelay</Name>
              <Description>The number of seconds to wait before attempting to unblock the vehicle when stationary, after the leading vehicle begins motion.</Description>
              <Hidden>1</Hidden>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>AffectsPathWeighting</Name>
              <Description>If true, when this vehicle is inhibited it increases the weighting of the occupying track segment (effect not visible). Other vehicles will find routes avoiding this vehicle when inhibited, if possible.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>AutoFillPitch</Name>
              <Description>The distance between vehicles when using AutoFill. On a loop, excess space will be equally distributed between all vehicles.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>AutoFill</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">2</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>AvoidCollisionsOnTrack</Name>
              <Description>If true, collision avoidance will be enabled for the vehicle while driving on track.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>CanBeAssigned</Name>
              <Description>If true, this vehicle is eligible to be assigned pickup jobs by the default job assignment.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>CanBeAssignedOnReset</Name>
              <Description>The value to set CanBeAssigned to, upon resetting the model.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>ChargeWhileParked</Name>
              <Description>If True and "Park" Visual Reference is set, vehicle will charge whilst at "Park" location, until a job is allocated.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>ClearSensorDelay</Name>
              <Description>The number of seconds to wait before unblocking the vehicle's front sensor, after the FrontSensorRange has been cleared.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>DistancePerCharge</Name>
              <Description>How far this vehicle can travel on a single charge</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Battery</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">100</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>FrontOffset</Name>
              <Description>Effective front location of vehicle, taken into consideration when accumulating vehicles and triggering Control Point events. The front location is calculated as the track position of the local origin of the vehicle plus this value, without considering the CAD.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">0.8849998712539673</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>FrontSensorRange</Name>
              <Description>Size of front sensor; distance required for vehicle to fully decelerate (i.e. (1/2 * max speed) * (max speed / decel)).</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">0.5</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>HangVertically</Name>
              <Description>Can be set to True to allow non-overhead vehicles to hang vertically when traversing vertical track systems. The value can also be set to True for Front and Rear Trackers of a Carrier when modeling inclines. Default: False.</Description>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>IsDualPoint</Name>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>IsFixed</Name>
              <Description>If true, overhead vehicles will not wait to be picked up by a dog to begin movement, optimizing performance.</Description>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>NumCharged</Name>
              <Description>The total number of times the vehicle has charged either partially or fully.</Description>
              <ReadOnly>1</ReadOnly>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Sim3D</Category>
              <Type>xsd:int</Type>
              <Value xsi:type="xsd:int">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>NumCompletedDropoffs</Name>
              <Description>The sum of loads from all completed delivery jobs, with destination outside the track system.</Description>
              <ReadOnly>1</ReadOnly>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Sim3D</Category>
              <Type>xsd:int</Type>
              <Value xsi:type="xsd:int">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>NumCompletedPickups</Name>
              <Description>The sum of loads from all completed pickup jobs.</Description>
              <ReadOnly>1</ReadOnly>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Sim3D</Category>
              <Type>xsd:int</Type>
              <Value xsi:type="xsd:int">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>OffsetVisualizationEnabled</Name>
              <Description>When enabled, the vehicle will have a visual overlay displaying the effective length according to the front and rear offsets.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Visualization</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>OptimizedAccumulationEnabled</Name>
              <Description>If true, the vehicle will follow the leading vehicle as close as possible while maintaining the AccumulationDistance. If false, the vehicle will be conservative when maintaining the AccumulationDistance and follow further behind the leading vehicle when in motion.</Description>
              <Hidden>1</Hidden>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>Park</Name>
              <Description>Location for vehicle to drive to when Idle</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>e3d:VisualReference</Type>
              <Value xsi:type="e3d:VisualReference" />
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>RearOffset</Name>
              <Description>Effective rear location of vehicle, taken into consideration when accumulating vehicles and triggering Control Point events. Usually a negative value. The rear location is calculated as the track position of the local origin of the vehicle plus this value, without considering the CAD.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">-0.8849998712539673</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>RotationEnabled</Name>
              <Description>If true, the rotation of this vehicle will be updated as it moves around the Track System. If false, the initial rotation of this vehicle will be maintained.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>ShowTargetLabel</Name>
              <Description>If true, the TargetLabel Visual will display the current target.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Debug</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">0</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>ShowTaskLabel</Name>
              <Description>If true, the TaskLabel Visual will display information relating to the current job.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Debug</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>SpeedLimitMode</Name>
              <Description>The mode of speed limit enforcement to be used by vehicles.

Default: A track section will apply its speed limitto the vehicle once the vehicle's origin enters the track section, and it will not be cleareduntil the vehicle's origin leaves the track section.

Strict: The vehicle will decelerate to obey the speed limit of track segments ahead of time.When the vehicle's front edge reaches the segment it will already be obeying the speed limitand when the rear edge of the vehicle clears the segment it will stop obeying the speed limit.Vehicles will travel at or below track section speed limits when any part of the vehicle iswithin a speed limit segment on the current path.

Manual: Speed limits from track sections will not be applied to vehicles. Speed limits may be setvia scripting without being overriden by internal Vehicle Framework behaviours.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>Demo3D.VehicleFramework.SpeedLimitMode</Type>
              <Value xsi:type="Demo3D.VehicleFramework.SpeedLimitMode">Default</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>TargetTolerance</Name>
              <Description>The tolerance for whether the vehicle is considered to be already at the target, when a DriveTo command is issued.</Description>
              <Hidden>1</Hidden>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>DriveModule</Category>
              <Type>xsd:double</Type>
              <Value xsi:type="xsd:double">0.05</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>UseSensorRange</Name>
              <Description>If true, the vehicle will use FrontSensorRange to determine when to start/stop to avoid collisions. If false, the vehicle will stop as necessary to maintain the minimum spacing given by AccumulationDistance.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Accumulation</Category>
              <Type>xsd:Boolean</Type>
              <Value xsi:type="xsd:Boolean">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>VehicleAcceleration</Name>
              <Category>Vehicle Speed</Category>
              <Type>e3d:AccelerationProperty</Type>
              <Value xsi:type="e3d:AccelerationProperty">2</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>VehicleDeceleration</Name>
              <Category>Vehicle Speed</Category>
              <Type>e3d:AccelerationProperty</Type>
              <Value xsi:type="e3d:AccelerationProperty">4</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
              <Name>VehicleList</Name>
              <Description>If vehicle is not track-based, bind reference to appropriate Track System Controller. If vehicle is track-based, bind reference to a Control Point for non-global dispatching.</Description>
              <CS>
                <Id>b141c3dd-a90d-4246-aecd-272577720547</Id>
              </CS>
              <Category>Vehicle</Category>
              <Type>e3d:VisualReference</Type>
              <Value xsi:type="e3d:VisualReference" />
