            <e xsi:type="e3d:CustomProperty">
              <Name>VehicleSpeed</Name>
              <Category>Vehicle Speed</Category>
              <Type>e3d:SpeedProperty</Type>
              <Value xsi:type="e3d:SpeedProperty">1</Value>
            </e>
            <e xsi:type="e3d:CustomProperty">
